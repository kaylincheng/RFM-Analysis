      "source": [
        "import pandas as pd\n",
        "\n",
        "# 1. 確保Date欄位為 datetime 格式（若你的 df 已經是則可省略此行）\n",
        "df[\"Date\"] = pd.to_datetime(df[\"Date\"])\n",
        "\n",
        "# 2. 找出整個資料集中的「最大Date」（作為計算 R 的基準點）\n",
        "max_date = df[\"Date\"].max()\n",
        "\n",
        "# 3. 進行 Groupby 聚合計算\n",
        "rfm_df = (\n",
        "    df.groupby(\"CustomerKey\")\n",
        "    .agg(\n",
        "        F=(\"InvoNo\", \"count\"),  # InvoNo計數\n",
        "        M=(\"Amount\", \"sum\"),  # Amount加總\n",
        "        # 計算該customer的最大Date，並與全體最大Date相減，最後轉換為天數\n",
        "        R=(\"Date\", lambda x: (max_date - x.max()).days),\n",
        "    )\n",
        "    .reset_index()\n",
        ")\n",
        "\n",
        "# 4. 重新命名欄位符合你的需求\n",
        "rfm_df = rfm_df.rename(columns={\"CustomerKey\": \"customer\"})\n",
        "\n",
        "# 調整欄位順序為：customer, F, M, R\n",
        "rfm_df = rfm_df[[\"customer\", \"F\", \"M\", \"R\"]]\n",
        "\n",
        "# 查看結果\n",
        "print(rfm_df)"
      ]

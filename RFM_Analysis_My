      "source": [
        "import pandas as pd\n",
        "from sklearn.preprocessing import MinMaxScaler\n",
        "\n",
        "# 1. 確保 Date 欄位為 datetime 格式並計算基準點\n",
        "df[\"Date\"] = pd.to_datetime(df[\"Date\"])\n",
        "max_date = df[\"Date\"].max()\n",
        "\n",
        "# 2. 進行 Groupby 聚合計算，取得 rfm_df\n",
        "rfm_df = (\n",
        "    df.groupby(\"CustomerKey\")\n",
        "    .agg(\n",
        "        F=(\"InvoNo\", \"count\"),\n",
        "        M=(\"Amount\", \"sum\"),\n",
        "        R=(\"Date\", lambda x: (max_date - x.max()).days),\n",
        "    )\n",
        "    .reset_index()\n",
        ")\n",
        "rfm_df = rfm_df.rename(columns={\"CustomerKey\": \"customer\"})\n",
        "rfm_df = rfm_df[[\"customer\", \"F\", \"M\", \"R\"]]\n",
        "\n",
        "# 3. 複製並執行 Min-Max 正規化處理，命名為 nrfm\n",
        "nrfm = rfm_df.copy()\n",
        "scaler = MinMaxScaler()\n",
        "nrfm[['F', 'M', 'R']] = scaler.fit_transform(nrfm[['F', 'M', 'R']])\n",
        "\n",
        "# 4. 顯示結果\n",
        "display(nrfm.head())"
      ],

        "\n",
        "# 2. 針對 F, M, R 正規化後的特徵進行分群預測\n",
        "nrfm['Cluster'] = kmeans.fit_predict(nrfm[['F', 'M', 'R']])\n",
        "\n",
        "# 3. 將分群結果也同步加回原始資料 rfm_df，方便解讀真實數值\n",
